#!/bin/sh
# Waits for the openHop setup wizard to set an admin password, then gives root the
# same password (for SSH and the LuCI web interface) and re-enables SSH password logins.
# Does nothing if root already has a password.
CONF=/etc/openhop_repeater/config.yaml
has_root_pw() { grep -q '^root:[^:!*][^:]*:' /etc/shadow; }
has_root_pw && exit 0
while :; do
	pw=$(python3 -c "import yaml;c=yaml.safe_load(open('$CONF')) or {};print(((c.get('repeater') or {}).get('security') or {}).get('admin_password') or '')" 2>/dev/null)
	if [ -n "$pw" ]; then
		printf '%s\n%s\n' "$pw" "$pw" | passwd root >/dev/null 2>&1
		/usr/libexec/meshcore-m2/ssh-access unlock
		logger -t meshcore-m2 "root password set to the dashboard admin password"
		exit 0
	fi
	sleep 30
done
