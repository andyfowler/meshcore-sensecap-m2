# /etc/config/meshcore - optional pre-configuration for a SenseCAP M2 MeshCore repeater
#
# You don't need to edit this. With the defaults below, the repeater starts on the
# US MeshCore preset and the openHop dashboard (http://<m2-address>:8000) walks you
# through first-time setup: name, radio preset and admin password.
#
# Fill it in only if you want a device that comes up fully configured (for example
# when building an image for yourself - see docs/building.md). It is applied once,
# on first boot. After that, the dashboard and the MeshCore app own the settings.
# Blank options are left at openHop's defaults.

config node 'node'
	option name ''                      # repeater name (adverts show the first 23 characters)
	option lat ''                       # decimal degrees, e.g. '42.2808'
	option lon ''                       # decimal degrees, e.g. '-83.7430'
	option owner_info ''                # contact info shown to other users; '|' = new line
	option admin_password ''            # blank = choose it in the dashboard's setup wizard
	option guest_password ''            # blank = anyone can query the repeater's status
	option root_password ''             # SSH / LuCI password; blank = same as the admin password
	option tx_power '22'                # dBm at the antenna connector (max 27)

config radio 'radio'
	# US/Canada MeshCore default preset
	option frequency '910525000'        # Hz
	option bandwidth '62500'            # Hz
	option spreading_factor '7'
	option coding_rate '5'              # 5..8 = 4/5..4/8
	option preamble '16'
	option sync_word '0x12'             # MeshCore

config mesh 'mesh'
	# Repeater behaviour. Blank = openHop default. Your local mesh group may
	# recommend specific values.
	option path_hash_mode ''            # 0 = 1-byte, 1 = 2-byte, 2 = 3-byte path hashes
	option advert_interval ''           # minutes between local (zero-hop) adverts, 60-240
	option flood_advert_interval ''     # hours between network-wide adverts
	option flood_max ''                 # max hops a flood packet may travel
	option agc_reset_interval ''
	option loop_detect ''               # minimal | moderate | strict
	option txdelay ''                   # flood retransmit delay factor
	option direct_txdelay ''            # direct retransmit delay factor
	option rxdelay ''
	option duty_cycle ''                # percent of airtime allowed; 100 = no limit
	# Regions, parent first, as 'name' or 'name:parent'. Example:
	#list region 'us'
	#list region 'us-east:us'

config wifi 'wifi'
	option enabled '0'                  # 1 = join a Wi-Fi network as a client
	option ssid ''
	option key ''
	option encryption 'psk2'            # psk2 | sae | sae-mixed | none
	option disable_ap '1'               # turn off any access point on the M2

config mqtt 'mqtt'
	# Publish what the repeater hears to MeshCore observer networks (maps, analyzers).
	# No passwords needed: uploads are signed with the repeater's own key.
	option enabled '0'
	option iata ''                      # region code your network uses, e.g. 'SEA'
	option owner ''                     # optional: your companion's public key
	option email ''                     # optional
	#list broker 'letsmesh'             # openHop presets: letsmesh, meshmapper, waev, ...
	#list broker 'meshmapper'
	#list disable_broker 'Europe (LetsMesh v1)'

config companion 'companion'
	# A second MeshCore node (a "companion") that the MeshCore app can use over
	# your network instead of Bluetooth: add a TCP device at <m2-address>:5000.
	option enabled '0'
	option name ''                      # blank = '<repeater name> companion'
	option tcp_port '5000'
	option tcp_timeout '0'              # seconds idle before disconnect; 0 = never
	option key_file '/etc/openhop_repeater/companion.key'   # generated if missing
