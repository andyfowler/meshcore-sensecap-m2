#!/bin/sh /etc/rc.common
# openHop MeshCore repeater daemon (talks to m2modem on 127.0.0.1:5055).

START=95
STOP=05
USE_PROCD=1
CONF=/etc/openhop_repeater/config.yaml
BOOTCLI=/etc/openhop_repeater/boot-cli.txt
HELPERS=/usr/libexec/meshcore-m2

start_service() {
	[ -f "$CONF" ] || $HELPERS/firstboot --force
	mkdir -p /var/lib/openhop_repeater
	[ -x $HELPERS/db-snapshot ] && $HELPERS/db-snapshot restore
	procd_open_instance
	procd_set_param command /usr/bin/python3 -m repeater.main --config "$CONF"
	# container=openwrt: openHop then restarts itself (after the setup wizard or a
	# settings change) by exiting, and procd starts it again. Its other restart
	# methods need systemd or Buildroot.
	procd_set_param env PYTHONPATH=/usr/lib/openhop:/usr/lib/openhop/vendor PYTHONDONTWRITEBYTECODE=1 container=openwrt
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_started() {
	# replay idempotent CLI setup (regions from /etc/config/meshcore) once the API is up
	[ -s "$BOOTCLI" ] && ( sleep 60; $HELPERS/apply-pending "$BOOTCLI" >/tmp/boot-cli.log 2>&1 ) &
	# give root the dashboard admin password once the setup wizard has set one
	[ -x $HELPERS/sync-root-password ] && ( $HELPERS/sync-root-password ) &
}

stop_service() {
	[ -x $HELPERS/db-snapshot ] && $HELPERS/db-snapshot save
}
